# Copy this file to `.env` before running `docker compose up`.
# docker compose automatically loads a `.env` file from this directory.

# Mongo database name used by the backend
DB_NAME=infraforge

# Secret used to sign JWT tokens. Generate a strong one, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string

# Seed admin account created on first startup
ADMIN_EMAIL=admin@infraforge.io
ADMIN_PASSWORD=ChangeMe@12345

# CORS: not required when served behind the bundled Nginx (same origin),
# but kept configurable for split deployments.
CORS_ORIGINS=*

# Public URL where the portal is reached (used for CORS on split setups)
FRONTEND_URL=http://localhost:8080

# Host port to expose the portal on
FRONTEND_PORT=8080
